# --- macOS ---
.DS_Store

# --- Gradle / JVM ---
.gradle/
build/
**/build/
local.properties
*.log

# --- Kotlin ---
.kotlin/

# --- IDE ---
**/.idea/*
!**/.idea/dictionaries
**/.idea/dictionaries/*
!**/.idea/dictionaries/dictionary.xml
*.iml
.vscode/

# --- Xcode ---
**/xcuserdata/
*.xcuserstate

# --- SwiftPM import ---
# The Kotlin Gradle plugin regenerates .swiftpm-locks/<id>/.gitignore with the directory form only,
# which does not match the symbolic link scripts/link-swiftpm-cache.sh puts in its place.
.swiftpm-locks/*/swiftPMCheckout

# --- Screenshot outputs (Roborazzi goldens; a CI golden store is a separate decision) ---
screenshots/

# --- VitePress docs site ---
docs-site/node_modules/
docs/node_modules
# vitepress build/dev resolve outDir and cache against the config's cwd (docs-site/),
# not srcDir, despite srcDir pointing at docs/.
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/
# Combined GitHub Pages artifact staged by .github/workflows/deploy-pages.yml
/dist/

# --- Release signing (copied in by app-android/release.sh) ---
app-android/keystore.properties
app-android/droidkaigi2026.keystore
app-android/src/prod/google-services.json

# --- App Store Connect CLI (asc) local release workflow ---
.asc/runs/
.asc/artifacts/
.asc/metadata/review/
