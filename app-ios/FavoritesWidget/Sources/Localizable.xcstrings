      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for joining us. See you next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご参加ありがとうございました。またお会いしましょう。"
